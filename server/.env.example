# ── Metrics server configuration ──────────────────────────────────────────
# Copy to `.env` and edit. Bun auto-loads `.env` from the working directory.

# Bind address / port. Keep HOST on loopback: Tailscale (funnel/serve) must be
# the ONLY path in, so the X-Forwarded-For client IP can't be forged by a direct
# connection. See deploy/TAILSCALE.md.
HOST=127.0.0.1
PORT=3000

# SQLite database file (created on first run, along with its directory).
DB_PATH=./data/metrics.db

# ── Access control (CIDR) ──────────────────────────────────────────────────
# Comma-separated CIDR allowlist (IPv4 + IPv6). The client IP is taken from the
# LEFTMOST X-Forwarded-For value that Tailscale injects (and replaces). Applies
# to BOTH the ingest API and the dashboard.
#
# Examples:
#   operators' office egress:  203.0.113.0/24
#   whole tailnet (serve):     100.64.0.0/10
#   a single host:             198.51.100.7/32
ALLOWED_CIDRS=

# When true (default), CIDR is enforced and an EMPTY/invalid allowlist FAILS
# CLOSED (denies everything) — a misconfig can't open the server to the internet.
# Set to false ONLY for local dev without a tunnel.
CIDR_ENFORCE=true

# ── Dashboard authentication (HTTP Basic) ──────────────────────────────────
# Gates the dashboard + its JSON/CSV endpoints (the ingest API is CIDR-only).
# Set EITHER user+password, OR a token (accepted as the Basic password with any
# username, or as a Bearer token).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please
# DASHBOARD_TOKEN=

# Which presence state counts as "available / eligible to take calls".
AVAILABLE_STATE=available

# Directory of the built SvelteKit dashboard (adapter-static output).
DASHBOARD_DIR=./dashboard/build

# Limits
MAX_BODY_BYTES=524288
FIRST_NAME_MAX_LEN=40
